# Selector de motor E-commerce activo: woocommerce | shopify | prestashop
ACTIVE_ECOMMERCE=shopify

# URL pública canónica del frontend (sin barra final)
PUBLIC_SITE_URL=https://www.mitienda.com

# --- WOOCOMMERCE REST API v3 ---
WC_API_URL=https://cms.mitienda.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SHOPIFY STOREFRONT GRAPHQL API ---
SHOPIFY_STORE_DOMAIN=mitienda.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# --- PRESTASHOP WEBSERVICE API ---
PS_API_URL=https://ps.mitienda.com
PS_WS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PS_DEFAULT_LANG_ID=1
PS_CURRENCY=EUR

# --- AUDITORÍA PRE-MIGRACIÓN DNS ---
LEGACY_SITEMAP_URL=https://www.mitienda.com/sitemap.xml
STAGING_BASE_URL=https://staging.mitienda.com
AUDIT_CONCURRENCY=15
