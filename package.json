{
  "name": "headless-ecommerce-astro-seo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/astro/astro.js dev",
    "start": "node ./dist/server/entry.mjs",
    "build": "node ./node_modules/astro/astro.js build",
    "preview": "node ./node_modules/astro/astro.js preview",
    "astro": "node ./node_modules/astro/astro.js",
    "audit:slugs": "node --import ./tests/ts-loader.mjs scripts/verify-slugs.ts",
    "test": "node --import ./tests/ts-loader.mjs --test tests/headless.test.ts",
    "test:coverage": "node --import ./tests/ts-loader.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"scripts/**\" --test-coverage-exclude=\"src/adapters/types.ts\" tests/headless.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.0.0",
    "@astrojs/node": "^8.3.4",
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.1",
    "astro": "^4.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.3",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
