---
import type { ProductImage } from '../../adapters/types';

interface Props {
  images: ProductImage[];
  productTitle: string;
  productSlug?: string;
  aspectRatio?: 'square' | 'portrait';
}

const { images, productTitle, productSlug, aspectRatio = 'square' } = Astro.props;

const aspectClass = aspectRatio === 'portrait' ? 'aspect-[4/5]' : 'aspect-square';
---

<!--
  Gallery.astro: Renderizado 100% estático (0 KB de JS en cliente).
  - Imagen [0]: fetchpriority="high", loading="eager", decoding="sync" -> LCP < 1.2s
  - Soporta View Transitions (transition:name) para animación fluida desde el Home/Colección.
-->
<section aria-label={`Galería de imágenes de ${productTitle}`} class="w-full">
  <div
    class:list={[
      'relative flex w-full overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-2xl bg-zinc-900 border border-zinc-800 no-scrollbar',
      aspectClass,
    ]}
  >
    {
      images.map((img, index) => {
        const isLcpCandidate = index === 0;
        return (
          <figure
            id={`product-slide-${index}`}
            class="relative h-full w-full shrink-0 snap-center flex items-center justify-center overflow-hidden bg-white p-4"
          >
            <img
              src={img.url}
              srcset={img.srcset || undefined}
              sizes="(min-width: 1280px) 600px, (min-width: 1024px) 50vw, 100vw"
              alt={img.alt || `${productTitle} - Vista ${index + 1}`}
              width={img.width || 1000}
              height={img.height || 1000}
              loading={isLcpCandidate ? 'eager' : 'lazy'}
              fetchpriority={isLcpCandidate ? 'high' : 'low'}
              decoding={isLcpCandidate ? 'sync' : 'async'}
              transition:name={
                isLcpCandidate && productSlug ? `product-image-${productSlug}` : undefined
              }
              class="h-full w-full object-contain object-center"
            />
          </figure>
        );
      })
    }
  </div>

  {
    images.length > 1 && (
      <nav
        aria-label="Miniaturas del producto"
        class="mt-3 grid grid-cols-5 sm:grid-cols-6 gap-2.5"
      >
        {images.map((img, index) => (
          <a
            href={`#product-slide-${index}`}
            aria-label={`Ver imagen ${index + 1} de ${productTitle}`}
            class="group relative aspect-square overflow-hidden rounded-xl border border-zinc-800 bg-white p-1.5 hover:border-[#FFCC00] focus:outline-none focus:ring-2 focus:ring-[#FFCC00]"
          >
            <img
              src={img.url}
              srcset={img.srcset || undefined}
              sizes="120px"
              alt=""
              width={120}
              height={120}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain object-center transition-transform duration-200 group-hover:scale-105"
            />
          </a>
        ))}
      </nav>
    )
  }
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
