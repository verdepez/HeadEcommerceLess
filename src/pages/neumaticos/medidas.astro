---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TireCalculatorWidget from '../../components/home/TireCalculatorWidget';
import { POPULAR_TIRE_MEASURES } from '../../data/offroad-catalog';

export const prerender = false;

const selectedMeasure = Astro.url.searchParams.get('medida') || '285/70R17';

const seo = {
  title: 'Neumáticos por medida — Todas las medidas 4x4 en Chile | DOBLETRACCIÓN',
  description:
    'Encuentra neumáticos por medida: 265/70R17, 285/70R17, 315/70R17, 35x12.5R17, 37x12.5R20 y más. Calculadora visual de altura y equivalencia en pulgadas.',
  canonicalUrl: '/neumaticos/medidas',
  robots: { index: true, follow: true },
};
---

<BaseLayout seo={seo}>
  <div class="home-dark bg-background text-foreground bg-topo bg-topo-invert min-h-screen py-12">
    <section class="container-dt space-y-10">
      <div class="space-y-2">
        <span class="font-button uppercase text-xs tracking-wider text-primary block">
          HERRAMIENTA TÉCNICA DOBLETRACCIÓN 4X4
        </span>
        <h1 class="font-display uppercase text-3xl md:text-5xl tracking-tight text-white">
          ENCUENTRA TU MEDIDA <span class="text-primary">Y CALCULA ALTURA</span>
        </h1>
        <p class="text-sm text-white/70 max-w-3xl">
          Compara tu neumático original con la nueva medida Off-Road: revisa el diámetro total en
          pulgadas, cuántos centímetros reales sube el diferencial de tu camioneta y qué nivel de
          suspensión necesitas.
        </p>
      </div>

      <TireCalculatorWidget client:load initialOem="265/65R17" initialUpgrade={selectedMeasure} />

      <div class="space-y-5 pt-4">
        <h2 class="font-display uppercase text-2xl md:text-3xl text-white">
          MEDIDAS CON MAYOR DEMANDA <span class="text-primary">EN 4X4 Y CAMIONETAS</span>
        </h2>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {
            POPULAR_TIRE_MEASURES.map((item) => (
              <div class="border border-white/15 bg-[hsl(var(--brand-black))] p-5 flex flex-col justify-between space-y-4 hover:border-primary transition-colors">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-button uppercase text-xs text-white/60">Aro {item.rim}</span>
                    {item.demandTag && (
                      <span class="bg-primary text-primary-foreground px-2 py-0.5 font-button uppercase text-[10px] font-bold">
                        {item.demandTag}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-2 font-display text-2xl text-white">{item.measure}</h3>
                  <p class="text-xs font-semibold text-primary">
                    {item.approxInches} de diámetro
                  </p>
                </div>

                <div class="flex gap-2">
                  <a
                    href={`/neumaticos/medidas?medida=${encodeURIComponent(item.measure)}`}
                    class="flex-1 border border-white/20 bg-white/[0.06] py-2 px-3 text-center font-button uppercase text-[11px] text-white hover:border-primary hover:text-primary transition-colors"
                  >
                    Simular
                  </a>
                  <a
                    href={`/collections/neumaticos?medida=${encodeURIComponent(item.measure)}`}
                    class="flex-1 bg-primary py-2 px-3 text-center font-button uppercase text-[11px] font-bold text-primary-foreground hover:brightness-95 transition-colors"
                  >
                    Ver Stock →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
