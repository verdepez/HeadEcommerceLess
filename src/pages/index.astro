// Helper para optimizar URLs del CDN de Shopify de dobletraccion.com (3c090e.myshopify.com)
function shopifyImg(url: string | undefined, width = 640): string {
  if (!url) {
    return `https://cdn.shopify.com/s/files/1/0802/3703/5825/collections/F150_RAPTOR_G3_GRIS_3.jpg?v=1756157888&width=${width}&format=webp&quality=80`;
  }
  if (!url.includes("cdn.shopify.com")) return url;
  const cleanUrl = url.split("?")[0];
  const versionMatch = url.match(/[?&]v=(\d+)/);
  const vParam = versionMatch ? `v=${versionMatch[1]}&` : "";
  return `${cleanUrl}?${vParam}width=${width}&format=webp&quality=80`;
}

function resolveCollectionImage(
  col: Category | null | undefined,
  fallbackShopifyUrl: string,
  width = 640
): string {
  const rawUrl =
    col?.image?.url ||
    col?.products?.[0]?.images?.[0]?.url ||
    fallbackShopifyUrl;
  return shopifyImg(rawUrl, width);
}

