---
import { getActiveCMS, getEcommerceAdapter } from "../adapters";
import type { SEOData, UnifiedProduct } from "../adapters/types";
import OffroadSearchHub from "../components/home/OffroadSearchHub";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPrice } from "../utils/formatters";

export const prerender = false;

const activeCms = getActiveCMS();
const adapter = getEcommerceAdapter(activeCms);

const homeCollections = [
  "kit-de-levante-y-suspension",
  "neumaticos-offroad-at-y-mt",
  "llantas",
  "neumaticos",
];

let featuredProducts: UnifiedProduct[] = [];
try {
  for (const slug of homeCollections) {
    const category = await adapter.getCategoryBySlug({ slug, perPage: 8 });
    if (category && category.products.length > 0) {
      featuredProducts = category.products.slice(0, 8);
      break;
    }
  }
  if (featuredProducts.length === 0 && adapter.getFeaturedProducts) {
    featuredProducts = await adapter.getFeaturedProducts(8);
  }
} catch (err) {
  console.error('[Home] Error cargando productos destacados:', err);
}

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=600"
);

const homeSeo: SEOData = {
  title: "DOBLETRACCIÓN 4x4 | Equipamiento Off-Road, Neumáticos, Llantas y Suspensión en Chile",
  description:
    "Especialistas en equipamiento 4x4 en Chile. Neumáticos BFGoodrich, Maxxis y Falken, llantas Method, Fuel y KMC, kits de levante y suspensión Fox y Old Man Emu con instalación en Santiago, Concepción y La Serena.",
  canonicalUrl: "/",
  robots: { index: true, follow: true },
  ogType: "website",
};
---

