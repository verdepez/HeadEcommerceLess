---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OffroadSearchHub from '../../components/home/OffroadSearchHub';
import { VEHICLE_DATABASE } from '../../data/offroad-catalog';

export const prerender = false;

const seo = {
  title: 'Garage interactivo · Encuentra productos 4x4 | DOBLETRACCIÓN',
  description:
    'Selecciona tu vehículo (marca, modelo y año) y descubre suspensiones, neumáticos, llantas y accesorios compatibles.',
  canonicalUrl: '/pages/garage-interactivo',
  robots: { index: true, follow: true },
};
---

<BaseLayout seo={seo}>
  <div class="home-dark bg-background text-foreground bg-topo bg-topo-invert min-h-screen py-12">
    <section class="container-dt space-y-10">
      <div class="space-y-2">
        <span class="font-button uppercase text-xs tracking-wider text-primary block">
          GARAGE DOBLETRACCIÓN 4X4
        </span>
        <h1 class="font-display uppercase text-3xl md:text-5xl tracking-tight text-white">
          EQUIPAMIENTO COMPATIBLE <span class="text-primary">CON TU VEHÍCULO</span>
        </h1>
        <p class="text-sm text-white/70 max-w-3xl">
          Selecciona tu camioneta o 4x4 (marca, modelo y año). Guardaremos tu vehículo en tu Garage
          personal y filtraremos apernadura, kits de levante y medidas de neumáticos compatibles.
        </p>
      </div>

      <OffroadSearchHub client:load initialTab="vehicle" />

      <div class="space-y-4 pt-4">
        <h2 class="font-display uppercase text-2xl md:text-3xl text-white">
          TABLA MAESTRA DE APERNADURAS <span class="text-primary">Y MEDIDAS POR CAMIONETA</span>
        </h2>
        <div class="overflow-x-auto border border-white/15 bg-[hsl(var(--brand-black))]">
          <table class="w-full text-left text-xs sm:text-sm text-white/85">
            <thead class="border-b border-white/15 bg-white/[0.05] font-button uppercase text-[11px] tracking-wider text-primary">
              <tr>
                <th class="px-4 py-3.5">Vehículo</th>
                <th class="px-4 py-3.5">Generación</th>
                <th class="px-4 py-3.5">Apernadura Llanta</th>
                <th class="px-4 py-3.5">Neumático OEM</th>
                <th class="px-4 py-3.5">Máx. con Levante 2&quot;</th>
                <th class="px-4 py-3.5 text-right">Catálogo</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              {
                VEHICLE_DATABASE.map((v) => (
                  <tr class="hover:bg-white/[0.04] transition-colors">
                    <td class="px-4 py-3 font-display uppercase text-white">
                      {v.brand} {v.model}
                    </td>
                    <td class="px-4 py-3 text-white/60">{v.generation}</td>
                    <td class="px-4 py-3">
                      <a
                        href={`/collections/${v.boltPatternSlug}`}
                        class="inline-block border border-primary/40 bg-white/[0.05] px-2.5 py-1 font-mono text-xs font-bold text-primary hover:bg-primary hover:text-primary-foreground transition-colors"
                      >
                        {v.boltPattern}
                      </a>
                    </td>
                    <td class="px-4 py-3 font-mono text-white/80">{v.oemTire}</td>
                    <td class="px-4 py-3 font-mono font-bold text-primary">
                      {v.maxTireWith2InchLift}
                    </td>
                    <td class="px-4 py-3 text-right">
                      <a
                        href={`/collections/${v.collectionSlug}`}
                        class="inline-block bg-primary px-3.5 py-1.5 font-button uppercase text-xs font-bold text-primary-foreground hover:brightness-95 transition-colors"
                      >
                        Ver Productos →
                      </a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
