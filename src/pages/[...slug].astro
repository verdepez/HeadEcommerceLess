---
import { getActiveCMS, getEcommerceAdapter } from '../adapters';
import type { Category, UnifiedProduct } from '../adapters/types';
import { resolveCMSRoute } from '../config/routing.config';
import DefaultProductTemplate from '../templates/DefaultProductTemplate.astro';
import MinimalProductTemplate from '../templates/MinimalProductTemplate.astro';
import CategoryTemplate from '../templates/CategoryTemplate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Modo SSR con soporte de caché en el Edge (Cloudflare / CDN) para garantizar LCP < 1.2s
export const prerender = false;

const activeCms = getActiveCMS();
const adapter = getEcommerceAdapter(activeCms);

const COLLECTION_FALLBACK_ALIASES: Record<string, string> = {
  'ranger-raptor': 'ranger',
  bronco: 'ford',
  maverick: 'ford',
  expedition: 'ford',
  'land-cruiser': 'toyota',
  prado: 'toyota',
  'neumaticos-rt': 'neumaticos-offroad-at-y-mt',
  '5x150': '5x1502',
  '6x1143': '6x1144',
  '8x170': '8x1656',
  all: 'todas-las-categorias',
  'levante-y-suspension': 'kit-de-levante-y-suspension',
};

// 1. Interpretar la ruta solicitada según el esquema del CMS activo (WooCommerce, Shopify o PrestaShop)
const routeMatch = resolveCMSRoute(Astro.url.pathname, activeCms);

let productData: UnifiedProduct | null = null;
let categoryData: Category | null = null;
let isNotFound = false;

if (!routeMatch) {
  isNotFound = true;
} else if (routeMatch.entityType === 'product') {
  productData = await adapter.getProductBySlug({
    slug: routeMatch.slug,
    id: routeMatch.id,
    categorySlug: routeMatch.categorySlug,
  });
  if (!productData) {
    isNotFound = true;
  }
} else if (routeMatch.entityType === 'category') {
  const pageParam = Number(Astro.url.searchParams.get('page') || '1') || 1;
  categoryData = await adapter.getCategoryBySlug({
    slug: routeMatch.slug,
    id: routeMatch.id,
    page: pageParam,
  });
  if (!categoryData) {
    const aliasSlug = COLLECTION_FALLBACK_ALIASES[routeMatch.slug.toLowerCase()];
    if (aliasSlug) {
      categoryData = await adapter.getCategoryBySlug({
        slug: aliasSlug,
        id: routeMatch.id,
        page: pageParam,
      });
    }
  }
  if (!categoryData) {
    isNotFound = true;
  }
}

// 2. Emitir respuesta HTTP 404 estricta si la ruta o la entidad no existen en el CMS
if (isNotFound) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
} else {
  // Cabeceras SWR para servir desde el Edge en < 50ms (clave para LCP < 1.2s)
  Astro.response.headers.set(
    'Cache-Control',
    'public, s-maxage=3600, stale-while-revalidate=86400'
  );
}

// Permitir previsualización o cambio de plantilla por query param (?template=minimal) o por configuración del producto
const requestedTemplate = Astro.url.searchParams.get('template');
const resolvedProductTemplate =
  requestedTemplate === 'minimal' || requestedTemplate === 'default'
    ? requestedTemplate
    : productData?.template || 'default';
---

{
  isNotFound ? (
    <BaseLayout
      seo={{
        title: '404 - Página no encontrada | DOBLETRACCIÓN 4x4',
        description: 'El producto o categoría que buscas no existe o ya no está disponible.',
        robots: { index: false, follow: false },
      }}
    >
      <div class="home-dark bg-background text-foreground bg-topo bg-topo-invert py-24">
        <section class="container-dt max-w-xl text-center space-y-5">
          <p class="font-button uppercase text-xs tracking-widest text-primary">
            HTTP 404 · {activeCms.toUpperCase()} ROUTER
          </p>
          <h1 class="font-display uppercase text-3xl md:text-5xl tracking-tight text-white">
            CONTENIDO <span class="text-primary">NO ENCONTRADO</span>
          </h1>
          <p class="text-sm text-white/70">
            La URL <code class="bg-white/10 border border-white/20 px-2 py-0.5 font-mono text-xs text-primary">{Astro.url.pathname}</code> no
            corresponde a ningún recurso activo en el catálogo.
          </p>
          <div class="pt-4 flex flex-wrap justify-center gap-3">
            <a
              href="/"
              class="h-11 px-6 inline-flex items-center justify-center bg-primary font-button text-xs font-bold uppercase tracking-wider text-primary-foreground hover:brightness-95 transition"
            >
              Volver al inicio
            </a>
            <a
              href="/pages/garage-interactivo"
              class="h-11 px-6 inline-flex items-center justify-center border border-white/20 bg-white/[0.06] font-button text-xs font-bold uppercase tracking-wider text-white hover:border-primary hover:text-primary transition"
            >
              Abrir Garage 4x4
            </a>
          </div>
        </section>
      </div>
    </BaseLayout>
  ) : productData ? (
    resolvedProductTemplate === 'minimal' ? (
      <MinimalProductTemplate product={productData} />
    ) : (
      <DefaultProductTemplate product={productData} />
    )
  ) : categoryData ? (
    <CategoryTemplate category={categoryData} />
  ) : null
}
