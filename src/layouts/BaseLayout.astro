    <script is:inline>
      (function () {
        function syncHeaderState() {
          // 1. Sincronizar Garage 4x4
          try {
            var rawGarage = localStorage.getItem("dt_active_vehicle_garage_v1");
            var labels = document.querySelectorAll("[data-dt-garage-label]");
            if (rawGarage) {
              var v = JSON.parse(rawGarage);
              var text = v && v.model ? v.model.toUpperCase() : "TU VEHICULO";
              labels.forEach(function (el) { el.textContent = text; });
            }
          } catch (e) {}

          // 2. Sincronizar contador y monto de Carrito
          try {
            var rawCart = localStorage.getItem("dt_headless_cart");
            var count = 0;
            var total = 0;
            if (rawCart) {
              var items = JSON.parse(rawCart);
              if (Array.isArray(items)) {
                count = items.reduce(function (acc, item) { return acc + (Number(item.quantity) || 1); }, 0);
                total = items.reduce(function (acc, item) { return acc + ((Number(item.price) || 0) * (Number(item.quantity) || 1)); }, 0);
              }
            }
            document.querySelectorAll("[data-dt-cart-count]").forEach(function (el) {
              el.textContent = String(count);
            });
            document.querySelectorAll("[data-dt-cart-total]").forEach(function (el) {
              el.textContent = "CLP $" + total.toLocaleString("es-CL");
            });
          } catch (e) {}

          // 3. Interactividad del Mega-Menú de 4 Columnas "VEHICULOS 4X4"
          var brandBtns = document.querySelectorAll("[data-mm-brand-btn]");
          var brandContents = document.querySelectorAll("[data-mm-brand-content]");
          brandBtns.forEach(function (btn) {
            if (btn.dataset.mmBound) return;
            btn.dataset.mmBound = "1";
            var activateBrand = function () {
              var targetId = btn.getAttribute("data-mm-brand-btn");
              brandBtns.forEach(function (b) {
                if (b.getAttribute("data-mm-brand-btn") === targetId) {
                  b.classList.add("bg-primary", "text-neutral-950", "font-bold");
                  b.classList.remove("hover:bg-neutral-100", "text-neutral-900");
                } else {
                  b.classList.remove("bg-primary", "text-neutral-950", "font-bold");
                  b.classList.add("hover:bg-neutral-100", "text-neutral-900");
                }
              });
              brandContents.forEach(function (content) {
                if (content.getAttribute("data-mm-brand-content") === targetId) {
                  content.classList.remove("hidden");
                  content.classList.add("contents");
                } else {
                  content.classList.add("hidden");
                  content.classList.remove("contents");
                }
              });
            };
            btn.addEventListener("mouseenter", activateBrand);
            btn.addEventListener("click", activateBrand);
          });

          // Hover sobre modelos en Columna 2 actualiza Columna 3 (GENERACIONES) y Columna 4 (HERO)
          document.querySelectorAll("[data-mm-model-card]").forEach(function (card) {
            if (card.dataset.mmModelBound) return;
            card.dataset.mmModelBound = "1";
            card.addEventListener("mouseenter", function () {
              var parentBrand = card.closest("[data-mm-brand-content]");
              if (!parentBrand) return;
              var modelName = card.getAttribute("data-mm-model-name") || "";
              var modelSlug = card.getAttribute("data-mm-model-slug") || "";
              var modelImg = card.getAttribute("data-mm-model-img") || "";
              var gensRaw = card.getAttribute("data-mm-model-gens") || "[]";
              var gens = [];
              try { gens = JSON.parse(gensRaw); } catch (e) {}

              var emptyEl = parentBrand.querySelector("[data-mm-gen-empty]");
              var listEl = parentBrand.querySelector("[data-mm-gen-list]");
              if (emptyEl && listEl) {
                emptyEl.classList.add("hidden");
                listEl.classList.remove("hidden");
                listEl.innerHTML = gens.map(function (g) {
                  return '<a href="/collections/' + modelSlug + '" class="flex items-center justify-between px-3 py-2.5 rounded-sm bg-neutral-100 hover:bg-primary text-neutral-900 font-button uppercase text-xs font-bold transition"><span>' + g + '</span><span>→</span></a>';
                }).join("") + '<div class="pt-2 mt-2 border-t border-neutral-200"><a href="/collections/' + modelSlug + '" class="inline-flex items-center gap-1 font-display uppercase text-[11px] text-neutral-900 hover:text-primary">VER TODO ' + modelName + ' →</a></div>';
              }

              var heroImg = parentBrand.querySelector("[data-mm-hero-img]");
              var heroTitle = parentBrand.querySelector("[data-mm-hero-title]");
              var heroLink = parentBrand.querySelector("[data-mm-hero-link]");
              var heroBtnText = parentBrand.querySelector("[data-mm-hero-btn-text]");
              if (heroImg && modelImg) heroImg.setAttribute("src", modelImg);
              if (heroTitle) heroTitle.textContent = "CONSTRUYE TU " + modelName;
              if (heroLink) heroLink.setAttribute("href", "/collections/" + modelSlug);
              if (heroBtnText) heroBtnText.textContent = "VER " + modelName;
            });
          });

          // 4. Eventos de botón GARAGE
          document.querySelectorAll("[data-dt-garage-btn]").forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              var searchSection = document.getElementById("dt-hero-search");
              if (searchSection) {
                searchSection.scrollIntoView({ behavior: "smooth", block: "center" });
              } else {
                window.location.href = "/pages/garage-interactivo";
              }
            });
          });

          // 5. Buscador del Header conectado a colecciones reales de Shopify
          document.querySelectorAll("header input[type=\"search\"][name=\"q\"]").forEach(function (input) {
            if (input.dataset.bound) return;
            input.dataset.bound = "1";
            var triggerSearch = function () {
              var val = (input.value || "").trim().toLowerCase();
              if (!val) return;
              if (val.includes("raptor")) window.location.href = "/collections/f-150-raptor";
              else if (val.includes("hilux")) window.location.href = "/collections/hilux";
              else if (val.includes("ranger")) window.location.href = "/collections/ranger";
              else if (val.includes("f-150") || val.includes("f150")) window.location.href = "/collections/f-150";
              else if (val.includes("4runner")) window.location.href = "/collections/4runner";
              else if (val.includes("tundra")) window.location.href = "/collections/tundra";
              else if (val.includes("wrangler")) window.location.href = "/collections/wrangler";
              else if (val.includes("gladiator")) window.location.href = "/collections/gladiator";
              else if (val.includes("silverado")) window.location.href = "/collections/silverado";
              else if (val.includes("ram")) window.location.href = "/collections/ram-1500";
              else if (val.includes("l200")) window.location.href = "/collections/l200";
              else if (val.includes("amarok")) window.location.href = "/collections/amarok";
              else if (val.includes("llanta") || val.includes("method") || val.includes("fuel") || val.includes("kmc")) window.location.href = "/collections/llantas?q=" + encodeURIComponent(val);
              else if (val.includes("fox") || val.includes("ome") || val.includes("susp") || val.includes("levante")) window.location.href = "/collections/kit-de-levante-y-suspension?q=" + encodeURIComponent(val);
              else window.location.href = "/collections/neumaticos?q=" + encodeURIComponent(val);
            };
            input.addEventListener("keydown", function (ev) {
              if (ev.key === "Enter") {
                ev.preventDefault();
                triggerSearch();
              }
            });
            var btn = input.parentElement && input.parentElement.querySelector("button");
            if (btn) {
              btn.addEventListener("click", triggerSearch);
            }
          });

          // 6. Menú móvil
          var drawer = document.getElementById("dt-mobile-drawer");
          document.querySelectorAll("[data-dt-mobile-menu-btn]").forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              if (drawer) drawer.classList.remove("hidden");
            });
          });
          document.querySelectorAll("[data-dt-mobile-menu-close]").forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              if (drawer) drawer.classList.add("hidden");
            });
          });
        }

        syncHeaderState();
        document.addEventListener("astro:page-load", syncHeaderState);
        window.addEventListener("dt:garage-updated", syncHeaderState);
        window.addEventListener("dt:cart-updated", syncHeaderState);
        window.addEventListener("storage", syncHeaderState);
      })();
    </script>
  </body>
</html>
