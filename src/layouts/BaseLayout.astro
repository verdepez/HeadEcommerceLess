    <script is:inline>
      (function () {
        function syncHeaderState() {
          // 1. Sincronizar Garage 4x4
          try {
            var rawGarage = localStorage.getItem("dt_active_vehicle_garage_v1");
            var labels = document.querySelectorAll("[data-dt-garage-label]");
            if (rawGarage) {
              var v = JSON.parse(rawGarage);
              var text = v && v.model ? v.model.toUpperCase() : "GARAGE";
              labels.forEach(function (el) { el.textContent = text; });
            } else {
              labels.forEach(function (el) { el.textContent = "GARAGE"; });
            }
          } catch (e) {}

          // 2. Sincronizar contador de Carrito
          try {
            var rawCart = localStorage.getItem("dt_headless_cart");
            var count = 0;
            if (rawCart) {
              var items = JSON.parse(rawCart);
              if (Array.isArray(items)) {
                count = items.reduce(function (acc, item) { return acc + (Number(item.quantity) || 1); }, 0);
              }
            }
            document.querySelectorAll("[data-dt-cart-count]").forEach(function (el) {
              el.textContent = String(count);
            });
          } catch (e) {}

          // 3. Eventos de botón GARAGE
          document.querySelectorAll("[data-dt-garage-btn]").forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              var searchSection = document.getElementById("dt-hero-search");
              if (searchSection) {
                searchSection.scrollIntoView({ behavior: "smooth", block: "center" });
              } else {
                window.location.href = "/pages/garage-interactivo";
              }
            });
          });

          // 4. Buscador del Header
          document.querySelectorAll("header input[type=\"search\"][name=\"q\"]").forEach(function (input) {
            if (input.dataset.bound) return;
            input.dataset.bound = "1";
            var triggerSearch = function () {
              var val = (input.value || "").trim().toLowerCase();
              if (!val) return;
              if (val.includes("hilux")) window.location.href = "/collections/toyota-hilux-2016";
              else if (val.includes("ranger")) window.location.href = "/collections/ford-ranger-2023";
              else if (val.includes("f-150") || val.includes("f150")) window.location.href = "/collections/ford-f150-2021";
              else if (val.includes("llanta") || val.includes("method") || val.includes("fuel")) window.location.href = "/collections/llantas?q=" + encodeURIComponent(val);
              else if (val.includes("fox") || val.includes("ome") || val.includes("susp") || val.includes("levante")) window.location.href = "/collections/kit-de-levante-y-suspension?q=" + encodeURIComponent(val);
              else window.location.href = "/collections/neumaticos?q=" + encodeURIComponent(val);
            };
            input.addEventListener("keydown", function (ev) {
              if (ev.key === "Enter") {
                ev.preventDefault();
                triggerSearch();
              }
            });
            var btn = input.parentElement && input.parentElement.querySelector("button");
            if (btn) {
              btn.addEventListener("click", triggerSearch);
            }
          });

          // 5. Menú móvil
          var drawer = document.getElementById("dt-mobile-drawer");
          document.querySelectorAll("[data-dt-mobile-menu-btn]").forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              if (drawer) drawer.classList.remove("hidden");
            });
          });
          document.querySelectorAll("[data-dt-mobile-menu-close]").forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              if (drawer) drawer.classList.add("hidden");
            });
          });
        }

        syncHeaderState();
        document.addEventListener("astro:page-load", syncHeaderState);
        window.addEventListener("dt:garage-updated", syncHeaderState);
        window.addEventListener("dt:cart-updated", syncHeaderState);
        window.addEventListener("storage", syncHeaderState);
      })();
    </script>
