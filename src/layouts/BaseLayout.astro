---
import type { Category, SEOData, UnifiedProduct } from "../adapters/types";
import SeoHead from "../components/seo/SeoHead.astro";

interface Props {
  seo: SEOData;
  product?: UnifiedProduct;
  category?: Category;
  lcpImage?: {
    url: string;
    srcset?: string;
    sizes?: string;
  };
}

const { seo, product, category, lcpImage } = Astro.props;
